{
  "name": "jask-docs",
  "private": true,
  "scripts": {
    "dev": "mint dev",
    "validate": "mint validate",
    "check:links": "mint broken-links --check-anchors --check-redirects",
    "check:a11y": "mint a11y",
    "check": "npm run validate && npm run check:links && npm run check:a11y"
  },
  "devDependencies": {
    "mint": "latest"
  },
  "overrides": {
    "react": "19.2.7"
  }
}
